# Supabase — clé ANON. La plateforme client ne lit QUE des vues en lecture seule,
# protégées par RLS (voir db/001_acces_client.sql).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mode démonstration : jeu de données fictif, sans aucun appel réseau.
# À N'ACTIVER QUE pour une démo ou du développement hors ligne — un bandeau
# rouge s'affiche en permanence pour qu'aucun chiffre ne soit pris pour réel.
VITE_DEMO=0

# Le site vitrine (site/), où vivent les pages légales que l'inscription fait
# accepter. Obligatoire en production ; en développement, http://localhost:5195.
VITE_URL_SITE=
