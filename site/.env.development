# Développement local : le site renvoie vers le serveur local de l'app (port 5190),
# pas vers la production. Voir URL_APPLICATION dans src/config/site.ts.
VITE_URL_APPLICATION=http://localhost:5190

# Les résultats publics lisent Supabase (migrations db/013 et db/014).
# LES VALEURS NE SONT PAS ICI : ce fichier est SUIVI PAR GIT. Elles vont dans
# site/.env.local, que .gitignore couvre — recopiez VITE_SUPABASE_URL et la clé
# anonyme depuis le .env de la racine. En production, ce sont des variables du
