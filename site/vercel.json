{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/fr", "destination": "https://crosswell.io/", "permanent": true },
    { "source": "/fr/:chemin*", "destination": "https://crosswell.io/", "permanent": true },
    { "source": "/en", "destination": "https://crosswell.io/", "permanent": true },
    { "source": "/en/:chemin*", "destination": "https://crosswell.io/", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.crosswell.io" }],
      "destination": "https://crosswell.io/",
      "permanent": true
    },
    {
      "source": "/:chemin*",
      "has": [{ "type": "host", "value": "www.crosswell.io" }],
      "destination": "https://crosswell.io/:chemin*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap-resultats.xml", "destination": "/api/sitemap-resultats" },
    { "source": "/resultats", "destination": "/api/resultats?chemin=/resultats" },
    { "source": "/resultats/:chemin*", "destination": "/api/resultats?chemin=/resultats/:chemin*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
